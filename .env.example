# ============================================================
#  Skopiuj ten plik jako .env i uzupełnij wartości.
#  NIGDY nie commituj .env do repozytorium!
#  W GitHub Actions ustaw te same zmienne jako Repository Secrets.
# ============================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=twoj_bot_token_od_botfather
TELEGRAM_CHAT_ID=twoj_chat_id

# --- ntfy.sh ---
NTFY_TOPIC=crypto-radar-filipfrey          # twoja prywatna nazwa topiku

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Reddit API (utwórz app na https://www.reddit.com/prefs/apps) ---
REDDIT_CLIENT_ID=twoj_reddit_client_id
REDDIT_CLIENT_SECRET=twoj_reddit_client_secret
REDDIT_USER_AGENT=crypto-radar:v2.0 (by u/TwojNickReddit)

# --- Opcjonalne (na razie nie używamy, ale zostawiamy na przyszłość) ---
# BIRDEYE_API_KEY=           # free tier nie wymaga klucza dla podstawowych endpointów
# HELIUS_API_KEY=            # na przyszłość jeśli chcesz on-chain streaming
